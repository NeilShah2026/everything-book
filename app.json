{
  "expo": {
    "name": "everythingBook",
    "slug": "everything-book",
    "version": "1.0.0",
    "scheme": "everythingbook",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.everythingbook.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.everythingbook.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b5c2233-7d3d-4781-96fe-3e7a40bcfead"
      }
    },
    "owner": "neilshah07"
  }
}
